# NeighbourGood Configuration
# Copy this file to .env and adjust values as needed.

# ── Secret key (REQUIRED) ───────────────────────────────────────────
# Generate one with:  openssl rand -hex 32
# Must be at least 32 characters. The app refuses to start without it.
NG_SECRET_KEY=

# ── Database ────────────────────────────────────────────────────────
# Docker Compose uses PostgreSQL (see docker-compose.yml).
# For local dev without Docker you can use SQLite instead:
# NG_DATABASE_URL=sqlite:///./neighbourgood.db
NG_DATABASE_URL=postgresql://neighbourgood:neighbourgood@localhost:5432/neighbourgood

# ── Debug mode ──────────────────────────────────────────────────────
# Set to true for local dev (allows default secret key, relaxes HSTS/CSP).
# NEVER enable in production.
NG_DEBUG=false

# ── Platform mode ───────────────────────────────────────────────────
# "blue" (normal) or "red" (crisis)
NG_PLATFORM_MODE=blue

# ── Instance identity (shown in /instance/info for federation) ──────
NG_INSTANCE_NAME=My NeighbourGood
NG_INSTANCE_DESCRIPTION=A neighbourhood resource-sharing community
NG_INSTANCE_REGION=Berlin, Germany
NG_INSTANCE_URL=https://neighbourgood.example.com
NG_ADMIN_NAME=Jane Doe
NG_ADMIN_CONTACT=admin@neighbourgood.example.com

# ── Platform admins ─────────────────────────────────────────────────
# Accounts with these emails get the platform admin role on their next
# request (federation directory, Red Sky alert broadcast, Telegram webhook
# registration). JSON array; removing an email does not demote the account.
# NG_ADMIN_EMAILS=["admin@neighbourgood.example.com"]

# ── BLE mesh ────────────────────────────────────────────────────────
# Mesh messages older than this are refused on sync (replay protection)
# NG_MESH_MAX_MESSAGE_AGE_HOURS=72

# ── Request limits ──────────────────────────────────────────────────
# Largest accepted request body in bytes (413 above it); image uploads
# use NG_MAX_IMAGE_SIZE instead
# NG_MAX_REQUEST_BODY_BYTES=1048576

# ── SMTP (optional – logs emails to console when unconfigured) ──────
# Also used for password reset links; without SMTP the link is only written to the backend log
# NG_SMTP_HOST=smtp.example.com
# NG_SMTP_PORT=587
# NG_SMTP_TLS=true
# NG_SMTP_USER=your-email@example.com
# NG_SMTP_PASSWORD=your-password
# NG_SMTP_FROM=noreply@neighbourgood.local

# ── Frontend URL (used in notification emails) ──────────────────────
NG_FRONTEND_URL=http://localhost:3800

# ── CORS allowed origins ────────────────────────────────────────────
NG_CORS_ORIGINS=["http://localhost:3800","http://localhost:5173"]

# ── Outbound webhooks ───────────────────────────────────────────────
# Webhook targets that resolve to private / loopback / link-local addresses are
# rejected (SSRF protection). Set to true to allow LAN targets.
# NG_WEBHOOK_ALLOW_PRIVATE=false
